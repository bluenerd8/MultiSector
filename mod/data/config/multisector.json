{
	# Key that opens the Multiplayer window in the campaign.
	# Uses LWJGL key names: F1-F12, A-Z, NUMPAD0, HOME, INSERT, etc.
	"hotkey":"F8",

	# Port for hosting and the default port for joining (TCP and UDP).
	"port":7777,

	# Show "press F8 to open Multiplayer" when a save loads.
	"showHintOnLoad":true,

	# Host only: when a friend starts downloading the world, pause everyone
	# until that friend is in the game, so they start in exactly the world
	# they downloaded. Unpausing stops the wait early. After 10 minutes the
	# game carries on by itself.
	"holdWhileJoining":true,

	# In a star system you share with the host, show the host's NPC fleets
	# (patrols, traders, pirates) instead of your game's own. Each player's
	# game still runs its own fleets everywhere else. Turn off if fleets
	# behave strangely, and please report it.
	"syncNpcFleets":true,

	# Host only: while you're in a dialog or menu, keep the NPC fleets in your
	# system moving for friends there (normally the game freezes them). The
	# fleet you're talking to stays put. Turn off if fleets act oddly after
	# your dialogs.
	"moveFleetsDuringHostDialogs":true,

	# Joining another player's battle opens a live view of it on your game, where you pilot
	# one of your ships (your flagship unless you pick another). Off: you only get a report.
	"jointBattleView":true,
	# The battle's game deploys every combat-ready ship of a player who joined, even beyond
	# the battle's deployment limit, so their fleet always takes part.
	"jointBattleDeployAll":true,
	# During a joint battle, both games write a table of every ship to starsector.log
	# ("battle check" on the leader's game, "view check" on the joiner's, same ship ids),
	# and the joiner's game lists any ship that differs from the leader's. For bug reports.
	"jointBattleChecks":true,

	# The players panel on the campaign map: who's where and doing what.
	# The hotkey shows or hides it; more detail is in the Multiplayer window.
	"showPlayersHud":true,
	"hudHotkey":"F7",
	# topLeft, topRight, bottomLeft or bottomRight
	"hudCorner":"topRight",
	# Nudge it if it covers something: pixels right (X) and down (Y). Negative moves left/up.
	"hudOffsetX":0,
	"hudOffsetY":0,
}
