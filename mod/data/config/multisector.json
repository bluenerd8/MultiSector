{
	# Key that opens the Multiplayer window in the campaign.
	# Uses LWJGL key names: F1-F12, A-Z, NUMPAD0, HOME, INSERT, etc.
	"hotkey":"F8",

	# Port for hosting and the default port for joining (TCP and UDP).
	"port":7777,

	# Show "press F8 to open Multiplayer" when a save loads.
	"showHintOnLoad":true,

	# Host only: when a friend starts downloading the world, pause everyone
	# until that friend is in the game, so they start in exactly the world
	# they downloaded. Unpausing stops the wait early. After 10 minutes the
	# game carries on by itself.
	"holdWhileJoining":true,

	# The players panel on the campaign map: who's where and doing what.
	# The hotkey shows or hides it; more detail is in the Multiplayer window.
	"showPlayersHud":true,
	"hudHotkey":"F7",
	# topLeft, topRight, bottomLeft or bottomRight
	"hudCorner":"topRight",
	# Nudge it if it covers something: pixels right (X) and down (Y). Negative moves left/up.
	"hudOffsetX":0,
	"hudOffsetY":0,
}
